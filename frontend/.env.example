# Frontend build-time env (Vite). Copy to .env.local for local overrides, or set
# these in the Netlify dashboard for production.

# Leave EMPTY for local dev — requests go through the Vite proxy to :8000.
# In production set to your deployed backend URL (no trailing slash), e.g.:
#   VITE_API_BASE=https://market-dashboard-api.onrender.com
VITE_API_BASE=

# Only needed if the backend sets API_AUTH_TOKEN. Must match it.
VITE_API_TOKEN=
