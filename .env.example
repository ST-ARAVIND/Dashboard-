# ============================================================
#  Indian Market Intelligence Dashboard — environment config
#  Copy this file to ".env" and fill in your values.
# ============================================================

# --- Angel One SmartAPI credentials (Phase 1) ---
# Get the API key by creating a "Market Feeds" / "Trading" app at
#   https://smartapi.angelbroking.com/  -> "Create an App"
ANGEL_API_KEY=
# Your Angel One login / client code (e.g. A123456)
ANGEL_CLIENT_CODE=
# The 4-digit MPIN you set for SmartAPI login (NOT your web password)
ANGEL_MPIN=
# The base32 TOTP SECRET shown when you enable TOTP at
#   https://smartapi.angelbroking.com/enable-totp
# (this is the long secret string, NOT a 6-digit code)
ANGEL_TOTP_SECRET=

# --- News (Phase 8) ---
# rss  -> free RSS feeds (Moneycontrol, ET, Business Standard) — no key needed
# newsapi -> https://newsapi.org/ (requires NEWS_API_KEY)
NEWS_PROVIDER=rss
NEWS_API_KEY=

# --- Sentiment model (Phase 8) ---
# vader   -> fast, no download (default)
# finbert -> finance-tuned; requires `pip install transformers torch`
SENTIMENT_MODEL=vader

# --- Analytics ---
# Risk-free rate used for Black-Scholes IV / Greeks (decimal, e.g. 0.065 = 6.5%)
RISK_FREE_RATE=0.065

# --- Storage ---
DATABASE_URL=sqlite:///./market.db

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scheduler ---
# How often (seconds) to snapshot OI during market hours for delta-OI charts
OI_SNAPSHOT_INTERVAL=180
